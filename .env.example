# Application Configuration
APP_NAME=CEAMS
APP_URL=http://localhost/CEAMS
APP_ENV=development
APP_DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ceams
DB_USER=root
DB_PASS=

# Session Configuration
SESSION_NAME=CEAMS_SESSION
SESSION_TIMEOUT=1800

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Email Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ceams.local
MAIL_FROM_NAME=CEAMS System

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# System Settings
TIMEZONE=Africa/Nairobi
CURRENCY=KES
